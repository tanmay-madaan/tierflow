# Adaptive LLM Router Environment Configuration
# Copy this file to .env (or backend/.env) and set your API key.

# ==============================================================================
# Google Gemini API (Recommended - Google AI Studio)
# Obtain a free key at: https://aistudio.google.com/
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default models per tier for Gemini (standard defaults already built-in)
# LLM_MODEL_SMALL=gemini-1.5-flash-8b
# LLM_MODEL_MEDIUM=gemini-1.5-flash
# LLM_MODEL_LARGE=gemini-1.5-pro

# ==============================================================================
# Alternative: OpenAI or OpenAI-Compatible Provider (Groq, OpenRouter, Ollama)
# ==============================================================================
# LLM_API_KEY=your_openai_or_groq_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_SMALL=gpt-4o-mini
# LLM_MODEL_MEDIUM=gpt-4o
# LLM_MODEL_LARGE=gpt-4-turbo

# Request settings
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=2
